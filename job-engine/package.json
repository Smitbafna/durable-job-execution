{
  "name": "@job-engine/core",
  "private": true,
  "version": "0.1.0",
  "description": "Distributed job execution engine — durable job lifecycle (Week 1: submit + retrieve via PostgreSQL)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "migrate": "node --env-file=.env --import tsx src/db/migrate.cli.ts",
    "worker": "node --env-file=.env --import tsx src/worker/workerRunner.ts",
    "test:unit": "vitest run",
    "test:integration": "docker compose up -d && vitest run -c vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.12.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^2.0.12",
    "supertest": "^7.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
